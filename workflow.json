{
  "name": "04 - HTTP API Example",
  "nodes": [
    {
      "parameters": {},
      "id": "1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "https://api.open-meteo.com/v1/forecast?latitude=35.7&longitude=51.4&current_weather=true",
        "options": {}
      },
      "id": "2",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fields": {
          "values": [
            { "name": "temperature", "value": "={{ $json.current_weather.temperature }}" }
          ]
        }
      },
      "id": "3",
      "name": "Extract Temperature",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "HTTP Request", "type": "main", "index": 0 }]]
    },
    "HTTP Request": {
      "main": [[{ "node": "Extract Temperature", "type": "main", "index": 0 }]]
    }
  }
}
