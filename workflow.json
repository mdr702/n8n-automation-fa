{
  "name": "05 - Webhook Example",
  "nodes": [
    {
      "parameters": {
        "path": "new-order",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "fields": {
          "values": [
            { "name": "receivedName", "value": "={{ $json.body.name }}" },
            { "name": "receivedEmail", "value": "={{ $json.body.email }}" }
          ]
        }
      },
      "id": "2",
      "name": "Extract Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [460, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Extract Data", "type": "main", "index": 0 }]]
    }
  }
}
